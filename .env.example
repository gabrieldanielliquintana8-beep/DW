# ============================================================
# Variáveis de ambiente do projeto Painel DW
# ============================================================
# Este arquivo é um MODELO. Os valores reais ficam:
#   - No Vercel (produção): Settings → Environment Variables
#   - No seu computador (dev): arquivo .env.local (nunca comitar)
# ============================================================

# --- Google Sheets API (leitura da planilha) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=planilha-bot@seu-projeto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
SPREADSHEET_ID=1AbC...xyz
SHEET_NAME=NomeExatoDaAba

# --- Login com Google ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com

# --- Sessão e autorização ---
# Gere com: crypto.randomUUID() + crypto.randomUUID() no console do navegador
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

# Lista de e-mails autorizados, separados por vírgula, sem espaços
EMAILS_PERMITIDOS=voce@hcpa.edu.br,colega@hcpa.edu.br
